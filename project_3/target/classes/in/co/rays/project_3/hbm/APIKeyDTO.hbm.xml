<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

    <class name="APIKeyDTO" table="ST_APIKEY">

        <id name="id" type="java.lang.Long">
            <column name="ID"/>
            <generator class="increment"/>
        </id>

        <property name="apikeyCode" type="java.lang.String">
            <column name="APIKEYCODE"/>
        </property>

        <property name="keyvalue" type="java.lang.String">
            <column name="KEYVALUE"/>
        </property>

        <property name="issuedTo" type="java.lang.String">
            <column name="ISSUEDTO"/>
        </property>

        <property name="status" type="java.lang.String">
            <column name="STATUS"/>
        </property>

        <!-- Common fields (same as CandidateDTO) -->

        <property name="createdBy" type="java.lang.String" length="50">
            <column name="CREATEDBY"/>
        </property>

        <property name="modifiedBy" type="java.lang.String" length="50">
            <column name="MODIFIEDBY"/>
        </property>

        <property name="createdDatetime" type="java.sql.Timestamp">
            <column name="CREATEDDATETIME"/>
        </property>

        <property name="modifiedDatetime" type="java.sql.Timestamp">
            <column name="MODIFIEDDATETIME"/>
        </property>

    </class>

</hibernate-mapping>